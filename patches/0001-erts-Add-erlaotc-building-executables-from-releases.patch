+%% Reads from the primary archive in the calling process, as the round trip
+%% to the loader process costs more than the read.
+client_archive(_Fun, _Archive, _FileInArchive, undefined) ->
+    request;
+client_archive(_Fun, _Archive, [], _ClientIndex) ->
+    request; % the archive itself
+client_archive(Fun, Archive, FileInArchive, {Files, Dirs, Mtime}) ->
+    case prim_file:read_file_info(Archive) of
+        {ok, #file_info{mtime = Mtime}} ->
+            Components = path_split(FileInArchive),
+            case Fun of
+                read_file ->
+                    case Files of
+                        #{Components := {_FI, undefined}} ->
+                            {ok, <<>>}; % a directory
+                        #{Components := {_FI, Location}} ->
+                            client_read(Archive, Mtime, FileInArchive,
+                                        Location);
+                        #{} ->
+                            {error, enoent}
+                    end;
+                list_dir ->
+                    case Dirs of
+                        #{Components := Names} -> {ok, Names};
+                        #{} -> {error, enotdir}
+                    end;
+                _ when Fun =:= read_file_info; Fun =:= read_link_info ->
+                    DirComponents = ["" | Components],
+                    case Files of
+                        #{Components := {FI, _}} -> {ok, FI};
+                        #{DirComponents := {FI, _}} -> {ok, FI};
+                        #{} -> {error, enoent}
+                    end
+            end;
+        _ ->
+            request
+    end.
+
+client_read(Archive, Mtime, FileInArchive, {Offset, Size, _CompMethod}) ->
+    Key = {?MODULE, Archive},
+    Fd = case get(Key) of
+             {Mtime, Fd0} ->
+                 Fd0;
+             Old ->
+                 case Old of
+                     {_OldMtime, OldFd} -> prim_file:close(OldFd);
+                     undefined -> ok
+                 end,
+                 {ok, Fd0} = prim_file:open(Archive, [read, binary, raw]),
+                 put(Key, {Mtime, Fd0}),
+                 Fd0
+         end,
+    case prim_file:pread(Fd, Offset, Size) of
+        {ok, Bin} ->
+            try
+                {ok, prim_zip:read_z_file(FileInArchive, Bin)}
+            catch
+                throw:Reason ->
+                    {error, Reason}
+            end;
+        eof ->
+            {error, einval};
+        {error, _} = Error ->
+            Error
+    end.
