 #include "erl_vm.h"
 #include "global.h"
+#include <string.h>
+#include "erl_helpers.h"
 
 int
 main(int argc, char **argv)
 {
+    if (argc >= 2 && strcmp(argv[1], "-erlaot:child_setup") == 0) {
+        return erl_child_setup_main(argc - 1, argv + 1);
+    }
+    if (argc >= 2 && strcmp(argv[1], "-erlaot:inet_gethost") == 0) {
+        return inet_gethost_main(argc - 1, argv + 1);
+    }
+    if (argc >= 2 && strcmp(argv[1], "-erlaot:epmd") == 0) {
+        return epmd_main(argc - 1, argv + 1);
+    }
+
     /* Must be done before we have a chance to spawn any scheduler threads. */
     sys_init_signal_stack();
 
