+/* JITC chunks: the JIT's code for a module, captured before relocation with
+ * its relocations and loader patches, so that the loader can install it
+ * without the JIT; atoms are not relocated, the executable replays the atom
+ * table instead (erl_aot.c). */
+
+#ifndef __BEAM_JITC_HPP__
+#define __BEAM_JITC_HPP__
