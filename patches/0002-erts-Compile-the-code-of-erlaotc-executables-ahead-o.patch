+
+/* Relocations in a chunk; `off` is where the value goes, `end` the end of
+ * the instruction for relative ones. */
+enum {
+    JITC_R_ABS64_MODULE = 0, /* u64: base + value */
+    JITC_R_REL32_MODULE = 1, /* i32: value - end */
+    JITC_R_REL32 = 2,        /* i32: target - (base + end) */
+    JITC_R_ADDRENTRY = 3,    /* as REL32, through the address table if far */
+    JITC_R_MOVSEQ = 4,       /* AArch64 movz/movk sequence: target */
+    JITC_R_ABS64 = 5,        /* u64: target */
+    JITC_R_ABS32 = 6         /* u32: target */
+};
+
+typedef struct BeamJitcRecordInfo_ {
+    Eterm module;
+    const BeamFile *beam;
+    const byte *src_code; /* The BEAM file as given to the loader */
+    Uint src_size;
+    unsigned current_li;
+    const int (*line_instr)[2]; /* {pos, loc} pairs */
+    const unsigned *func_line;  /* function_count entries or NULL */
+    const byte *are_nifs;       /* function_count entries or NULL */
+    unsigned function_number;
+    const SWord *lambda_literals; /* beam->lambdas.count entries */
+    int dyn_base; /* dynamic literals created by beamfile_read() */
+} BeamJitcRecordInfo;
+
+typedef struct BeamJitcRestoreInfo_ {
+    BeamFile *beam;
+    unsigned *current_li;
+    int (*line_instr)[2];   /* capacity: beam->lines.instruction_count */
+    unsigned *func_line;    /* capacity: function_count, or NULL */
+    byte *are_nifs;         /* capacity: function_count; set when has_nifs */
+    int *has_nifs;
+    unsigned *function_number;
+    SWord *lambda_literals; /* beam->lambdas.count entries */
+} BeamJitcRestoreInfo;
+
+int beamjitc_atom_indices(const byte *chunk,
+                          Sint32 size,
+                          const Uint32 **indices,
+                          Uint32 *count,
+                          const byte **checksum);
