+    if (erts_aot_recording) {
+        int fd = open("/dev/urandom", O_RDONLY);
+        if (fd < 0 || read(fd, erts_aot_build_id, 16) != 16)
+            fatal("cannot read /dev/urandom", strerror(errno));
+        close(fd);
+        return;
+    }
+
+    if (atoms == NULL)
+        return;
+
+    res = erts_atom_replay(&pos, atoms_end, 0, n_atoms);
+    if (res < 0) {
+        fprintf(stderr, "%s: cannot replay atom %ld of the snapshot\n",
+                exe_path, (long) (-1 - res));
+        exit(1);
+    }
+    erts_aot_active = 1;
