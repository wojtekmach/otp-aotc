+ErtsCodePtr beamjitc_get_lambda(void *inst, int index);
+const byte *beamjitc_get_rodata(void *inst, const char *label);
+Uint beamjitc_get_header(void *inst, const BeamCodeHeader **hdr);
+char *beamjitc_get_base(void *inst);
+size_t beamjitc_get_offset(void *inst);
+const ErtsCodeInfo *beamjitc_get_on_load(void *inst);
+unsigned int beamjitc_patch_catches(void *inst, char *rw_base);
+void beamjitc_patch_import(void *inst,
+                           char *rw_base,
+                           int index,
+                           const Export *import);
+void beamjitc_patch_literal(void *inst, char *rw_base, int index, Eterm lit);
+void beamjitc_patch_lambda(void *inst,
+                           char *rw_base,
+                           int index,
+                           const ErlFunEntry *fe);
+void beamjitc_patch_strings(void *inst, char *rw_base, const byte *strtab);
+void *beamjitc_register_metadata(void *inst, const BeamCodeHeader *header);
+
