+/*
+ * Inserts atoms `first` .. `first + count - 1` from `*data`, `count` entries
+ * of (u16 len, utf8 name), advancing `*data`. Used to replay the atom table
+ * snapshot of an erlaotc executable. Entries below the current table size
+ * must match the existing atoms. Returns count, or -1 - index on failure.
+ */
+Sint erts_atom_replay(const byte **data, const byte *end, Uint first, Uint count)
+{
+    const byte *p = *data;
+    Uint existing;
+    Uint i;
+    Sint result = count;
+
+    atom_write_lock();
+    existing = (Uint) erts_atom_table.entries;
+    hash_reserve(&erts_atom_table.htable, (int) (first + count));
+
+    for (i = first; i < first + count; i++) {
+        Uint len;
+        const byte *name;
+        Atom a;
+        IndexSlot *slot;
+        const byte *err_pos;
+        Uint no_chars;
+        Sint no_latin1_chars;
+
+        if (end - p < 2) {
+            result = -1 - (Sint) i;
+            break;
+        }
+        len = p[0] | (p[1] << 8);
+        p += 2;
+        if ((Uint) (end - p) < len) {
+            result = -1 - (Sint) i;
+            break;
+        }
+        name = p;
+        p += len;
+
+        if (i < existing) {
+            Atom *ap = atom_tab(i);
+            if ((Uint) ap->len != len ||
+                sys_memcmp(erts_atom_get_name(ap), name, len) != 0) {
+                result = -1 - (Sint) i;
+                break;
+            }
+            continue;
+        }
+
+        if (i > existing) {
+            /* Atoms were created out of order; cannot continue. */
+            result = -1 - (Sint) i;
+            break;
+        }
+
+        if (erts_analyze_utf8_x((byte *) name, len, &err_pos, &no_chars, NULL,
+                                &no_latin1_chars, MAX_ATOM_CHARACTERS)
+            != ERTS_UTF8_OK) {
+            result = -1 - (Sint) i;
+            break;
+        }
+
+        a.len = (Sint16) len;
+        a.latin1_chars = (Sint16) no_latin1_chars;
+        a.u.name = (byte *) name;
+        slot = index_put_entry(&erts_atom_table, (void *) &a);
+        if (slot->index != (int) i) {
+            result = -1 - (Sint) i;
+            break;
+        }
+        existing = i + 1;
+    }
+
+    atom_write_unlock();
+    *data = p;
+    return result;
+}
