+static void mkdir_p(const char *path)
+{
+    char *copy = xmalloc(strlen(path) + 1), *p;
+
+    strcpy(copy, path);
+    for (p = copy + 1; *p != '\0'; p++) {
+        if (*p == '/') {
+            *p = '\0';
+            if (mkdir(copy, 0755) != 0 && errno != EEXIST)
+                fatal("cannot create directory", copy);
+            *p = '/';
+        }
+    }
+    if (mkdir(copy, 0755) != 0 && errno != EEXIST)
+        fatal("cannot create directory", copy);
+    free(copy);
+}
+
+static void write_file(const char *name, const byte *data, size_t size)
+{
+    char *path = xmalloc(strlen(record_dir) + strlen(name) + 2);
+    char *slash;
+    int fd;
+
+    sprintf(path, "%s/%s", record_dir, name);
+    slash = strrchr(path, '/');
+    *slash = '\0';
+    mkdir_p(path);
+    *slash = '/';
+
+    fd = open(path, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+    if (fd < 0)
+        fatal("cannot create file", path);
+    while (size > 0) {
+        ssize_t w = write(fd, data, size);
+        if (w < 0) {
+            if (errno == EINTR)
+                continue;
+            fatal("cannot write file", path);
+        }
+        data += w;
+        size -= (size_t)w;
+    }
+    close(fd);
+    free(path);
+}
+
+static int entry_module(const ZipEntry *e, char *name, size_t size)
+{
+    const char *base = e->name + e->name_len;
+    size_t len;
+
+    while (base > e->name && base[-1] != '/')
+        base--;
+    len = e->name + e->name_len - base;
+    if (len < 6 || len - 5 >= size)
+        return 0;
+    memcpy(name, base, len - 5);
+    name[len - 5] = '\0';
+    return 1;
+}
+
+static int is_lib_beam(const ZipEntry *e)
+{
+    return name_starts_with(e, "lib/") && name_ends_with(e, ".beam");
+}
+
+static void record_load(ZipEntry *e)
+{
+    char name[MAX_ATOM_SZ_LIMIT];
+    const byte *code = entry_data(e);
+    Eterm module, res;
+
+    if (!entry_module(e, name, sizeof(name)))
+        fatal("bad module name", e->name);
+    module = erts_atom_put((byte *)name, strlen(name), ERTS_ATOM_ENC_UTF8, 1);
+    res = erts_preload_module(NULL, 0, NIL, &module, code, e->size);
+    if (res != NIL && res != am_on_load) {
+        erts_fprintf(stderr, "%s: cannot load %s: %T\n", exe_path, e->name,
+                     res);
+        exit(1);
+    }
+}
+
+static int recorded_index(const char *name)
+{
+    int j, n = beamjitc_recorded_count();
+    for (j = 0; j < n; j++) {
+        char rname[MAX_ATOM_SZ_LIMIT];
+        const byte *data;
+        size_t size;
+        beamjitc_recorded_get(j, rname, sizeof(rname), &data, &size);
+        if (strcmp(name, rname) == 0)
+            return j;
+    }
+    return -1;
+}
+
+void erts_aot_record_run(void)
+{
+    Uint32 i;
+    int j, n_recorded, n;
+    Uint count;
+    byte *snapshot, *p;
+    size_t snapshot_size;
+    unsigned char uuid[16];
+    char path[512];
+
+    if (!erts_aot_recording)
+        return;
+
+    for (i = 0; i < n_entries; i++) {
+        if (is_lib_beam(&entries[i]))
+            record_load(&entries[i]);
+    }
+
+    n_recorded = beamjitc_recorded_count();
+    for (i = 0; i < n_entries; i++) {
+        char name[MAX_ATOM_SZ_LIMIT];
+        const byte *data;
+        size_t size;
+        char *ename;
+
+        if (!is_lib_beam(&entries[i]))
+            continue;
+        entry_module(&entries[i], name, sizeof(name));
+        j = recorded_index(name);
+        if (j < 0)
+            fatal("the module was not recorded", name);
+        beamjitc_recorded_get(j, name, sizeof(name), &data, &size);
+        ename = xmalloc(entries[i].name_len + 1);
+        memcpy(ename, entries[i].name, entries[i].name_len);
+        ename[entries[i].name_len] = '\0';
+        write_file(ename, data, size);
+        free(ename);
+    }
+    for (j = 0; j < n_recorded; j++) {
+        char name[MAX_ATOM_SZ_LIMIT];
+        const byte *data;
+        size_t size;
+        int in_archive = 0;
+
+        beamjitc_recorded_get(j, name, sizeof(name), &data, &size);
+        for (i = 0; i < n_entries && !in_archive; i++) {
+            char ename[MAX_ATOM_SZ_LIMIT];
+            in_archive = is_lib_beam(&entries[i]) &&
+                         entry_module(&entries[i], ename, sizeof(ename)) &&
+                         strcmp(name, ename) == 0;
+        }
+        if (in_archive)
+            continue;
+        n = snprintf(path, sizeof(path), JITC_DIR "preloaded/%s.beam", name);
+        if (n < 0 || n >= (int)sizeof(path))
+            fatal("module name too long", name);
+        write_file(path, data, size);
+    }
+
+    count = atom_table_size();
+    snapshot_size = ATOMS_HEADER_SIZE;
+    for (i = 0; i < count; i++)
+        snapshot_size += 2 + atom_tab(i)->len;
+    snapshot = p = xmalloc(snapshot_size);
+    memcpy(p, ATOMS_MAGIC, 8);
+    erts_aot_emulator_uuid(uuid);
+    memcpy(p + 8, uuid, 16);
+    memcpy(p + 24, erts_aot_build_id, 16);
+    p[40] = count & 0xff;
+    p[41] = (count >> 8) & 0xff;
+    p[42] = (count >> 16) & 0xff;
+    p[43] = (count >> 24) & 0xff;
+    p += ATOMS_HEADER_SIZE;
+    for (i = 0; i < count; i++) {
+        Atom *a = atom_tab(i);
+        p[0] = a->len & 0xff;
+        p[1] = (a->len >> 8) & 0xff;
+        memcpy(p + 2, erts_atom_get_name(a), a->len);
+        p += 2 + a->len;
+    }
+    write_file(JITC_DIR "atoms", snapshot, snapshot_size);
+
+    exit(0);
+}
+
+#else /* !ERTS_JITC */
+
+void erts_aot_record_run(void)
