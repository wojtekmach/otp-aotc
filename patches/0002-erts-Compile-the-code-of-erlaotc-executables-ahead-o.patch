+
+
+#include <cstring>
+#include <mutex>
+#include <unordered_map>
+#include <string>
+#include <vector>
+
+#include "beam_asm.hpp"
+#include "beam_jitc.hpp"
+
+#ifdef ERTS_JITC
+
+extern "C"
+{
+#include "beam_catches.h"
+#include "atom.h"
+#include "erl_aot.h"
+#include "external.h"
+#include "erl_message.h"
+#include <dlfcn.h>
+}
+
+static std::string getAtomName(Eterm atom) {
+    char buf[MAX_ATOM_SZ_LIMIT];
+    int n = erts_snprintf(buf, sizeof(buf), "%T", atom);
+    return std::string(buf, n);
+}
+
+/* Provided by beam_jit_main.cpp */
+JitAllocator *beamasm_jit_allocator(void);
+BeamGlobalAssembler *beamasm_global_assembler(void);
+
+
+#define JITC_MAGIC "JITCv001"
+
+enum {
+    JITC_PTR_ERTS = 0,     /* value = offset from the executable's base */
+    JITC_PTR_FRAGMENT = 1, /* value = global fragment index */
+    JITC_PTR_DYLIB = 2     /* symbol name */
+};
+
+
+/* ------------------------------------------------------------------------
+ * Helpers
+ * ------------------------------------------------------------------------ */
+
+static const void *erts_image_base(void) {
+    static const void *base = nullptr;
+    if (base == nullptr) {
+        Dl_info info;
+        if (dladdr((void *)&erts_aot_emulator_uuid, &info) == 0) {
+            erts_exit(ERTS_ERROR_EXIT, "jitc: dladdr failed on self\n");
+        }
+        base = info.dli_fbase;
+    }
+    return base;
+}
+
+struct PtrClass {
+    int kind;
+    uint64_t value;
+    std::string name;
+};
+
+static bool classify_ptr(uintptr_t v, PtrClass &out) {
+    BeamGlobalAssembler *bga = beamasm_global_assembler();
+    Dl_info info;
+
+    if (v < 0x10000) {
+        return false;
+    }
+
+    {
+        uintptr_t gbase = (uintptr_t)bga->getBaseAddress();
+        uintptr_t gsize = bga->getCodeSize();
+
+        if (v >= gbase && v < gbase + gsize) {
+            int idx = bga->fragment_index((void (*)(void))v);
+            if (idx < 0) {
+                erts_exit(ERTS_ERROR_EXIT,
+                          "jitc: address %p is inside the global fragments "
+                          "but is not a fragment entry\n",
+                          (void *)v);
+            }
+            out.kind = JITC_PTR_FRAGMENT;
+            out.value = idx;
+            return true;
+        }
+    }
+
+    if (dladdr((void *)v, &info) == 0 || info.dli_fbase == nullptr) {
+        return false;
+    }
+
+    if (info.dli_fbase == erts_image_base()) {
+        out.kind = JITC_PTR_ERTS;
+        out.value = v - (uintptr_t)info.dli_fbase;
+        return true;
+    }
+
+    if (info.dli_sname != nullptr && info.dli_saddr == (void *)v) {
+        out.kind = JITC_PTR_DYLIB;
+        out.value = 0;
+        out.name = info.dli_sname;
+        return true;
+    }
+
+    return false;
+}
+
+static uintptr_t resolve_ptr(int kind, uint64_t value, const char *name) {
+    switch (kind) {
+    case JITC_PTR_ERTS:
+        return (uintptr_t)erts_image_base() + value;
+    case JITC_PTR_FRAGMENT: {
+        void (*p)(void) = beamasm_global_assembler()->fragment_ptr(value);
+        ERTS_ASSERT(p != nullptr);
+        return (uintptr_t)p;
+    }
+    case JITC_PTR_DYLIB: {
+        void *p = dlsym(RTLD_DEFAULT, name);
+        if (p == nullptr) {
+            erts_exit(ERTS_ERROR_EXIT,
+                      "jitc: cannot resolve symbol %s\n",
+                      name);
+        }
+        return (uintptr_t)p;
+    }
+    }
+    ERTS_ASSERT(!"bad pointer kind");
+    return 0;
+}
+
+struct Writer {
+    std::vector<byte> buf;
+
+    void u8(unsigned v) {
+        buf.push_back((byte)v);
+    }
+    void u16(unsigned v) {
+        for (int i = 0; i < 2; i++)
+            buf.push_back((byte)(v >> (8 * i)));
+    }
+    void u32(uint32_t v) {
+        for (int i = 0; i < 4; i++)
+            buf.push_back((byte)(v >> (8 * i)));
+    }
+    void i32(int32_t v) {
+        u32((uint32_t)v);
+    }
+    void u64(uint64_t v) {
+        for (int i = 0; i < 8; i++)
+            buf.push_back((byte)(v >> (8 * i)));
+    }
+    void bytes(const void *p, size_t n) {
+        buf.insert(buf.end(), (const byte *)p, (const byte *)p + n);
+    }
+    void str(const std::string &s) {
+        u16(s.size());
+        bytes(s.data(), s.size());
+    }
+};
+
+struct Reader {
+    const byte *p;
+    const byte *end;
+    bool ok = true;
+
+    Reader(const byte *data, size_t size) : p(data), end(data + size) {
+    }
+
+    bool need(size_t n) {
+        if ((size_t)(end - p) < n) {
+            ok = false;
+            return false;
+        }
+        return true;
+    }
+    unsigned u8() {
+        if (!need(1))
+            return 0;
+        return *p++;
+    }
+    unsigned u16() {
+        if (!need(2))
+            return 0;
+        unsigned v = p[0] | (p[1] << 8);
+        p += 2;
+        return v;
+    }
+    uint32_t u32() {
+        if (!need(4))
+            return 0;
+        uint32_t v;
+        memcpy(&v, p, 4);
+        p += 4;
+        return v;
+    }
+    int32_t i32() {
+        return (int32_t)u32();
+    }
+    uint64_t u64() {
+        if (!need(8))
+            return 0;
+        uint64_t v;
+        memcpy(&v, p, 8);
+        p += 8;
+        return v;
+    }
+    const byte *bytes(size_t n) {
+        if (!need(n))
+            return nullptr;
+        const byte *r = p;
+        p += n;
+        return r;
+    }
+};
+
+static inline uint32_t rd_u32(const byte *p) {
+    uint32_t v;
+    memcpy(&v, p, 4);
+    return v;
+}
+
+static inline uint64_t rd_u64(const byte *p) {
+    uint64_t v;
+    memcpy(&v, p, 8);
+    return v;
+}
+
+/* ------------------------------------------------------------------------
+ * Recording
+ * ------------------------------------------------------------------------ */
+
+static void classify_or_die(Eterm mod,
+                            uintptr_t v,
+                            BeamAssemblerCommon::JitcReloc &r) {
+    PtrClass pc;
+    if (!classify_ptr(v, pc)) {
+        erts_exit(ERTS_ERROR_EXIT,
+                  "jitc: cannot classify pointer %p in module %T\n",
+                  (void *)v,
+                  mod);
+    }
+    r.kind = pc.kind;
+    r.value = pc.value;
+    r.name = pc.name;
+}
+
+/* Captures the code before relocation, with asmjit's relocations. */
+void BeamModuleAssembler::jitc_pre_relocate() {
+    if (!erts_aot_recording) {
+        return;
+    }
+
+    jitc_snapshot.resize(code.code_size());
+    code.copy_flattened_data(jitc_snapshot.data(),
+                             jitc_snapshot.size(),
+                             CopySectionFlags::kPadSectionBuffer);
+
+    if (code.has_address_table_section()) {
+        jitc_addrtab_off = code.address_table_section()->offset();
+    }
+
+    for (const RelocEntry *re : code.reloc_entries()) {
+        Section *src, *dst = nullptr;
+        JitcReloc r;
+        unsigned size = re->format().value_size();
+
+        if (re->reloc_type() == RelocType::kNone) {
+            continue;
+        }
+
+        src = code.section_by_id(re->source_section_id());
+        if (re->target_section_id() != Globals::kInvalidId) {
+            dst = code.section_by_id(re->target_section_id());
+        }
+        r.off = src->offset() + re->source_offset() + re->format().value_offset();
+        r.end = src->offset() + re->source_offset() + re->format().region_size();
+        r.kind = 0;
+
+        switch (re->reloc_type()) {
+        case RelocType::kRelToAbs:
+            if (size != 8 || dst == nullptr) {
+                goto unsupported;
+            }
+            r.type = JITC_R_ABS64_MODULE;
+            r.value = re->payload() + dst->offset();
+            break;
+        case RelocType::kAbsToRel:
+            if (size != 4 || dst != nullptr) {
+                goto unsupported;
+            }
+            r.type = JITC_R_REL32;
+            classify_or_die(mod, (uintptr_t)re->payload(), r);
+            break;
+        case RelocType::kX64AddressEntry:
+            if (size != 4 || dst != nullptr) {
+                goto unsupported;
+            }
+            r.type = JITC_R_ADDRENTRY;
+            classify_or_die(mod, (uintptr_t)re->payload(), r);
+            break;
+        default:
+        unsupported:
+            erts_exit(ERTS_ERROR_EXIT,
+                      "jitc: unsupported asmjit relocation (type %d, size %d) "
+                      "in module %T\n",
+                      (int)re->reloc_type(),
+                      size,
+                      mod);
+        }
+        jitc_relocs.push_back(std::move(r));
+    }
+}
+
+#ifdef __aarch64__
+void BeamModuleAssembler::mov_ptr(a64::Gp to, const void *ptr) {
+    if (!erts_aot_recording) {
+        mov_imm(to, ptr);
+        return;
+    }
+
+    UWord v = (UWord)ptr;
+
+    ASSERT(to.isGpX());
+    jitc_ptr_relocs.push_back({a.offset(), ptr});
+
+    a.movz(to, imm(v & 0xFFFF), imm(0));
+    a.movk(to, imm((v >> 16) & 0xFFFF), imm(16));
+    a.movk(to, imm((v >> 32) & 0xFFFF), imm(32));
+    a.movk(to, imm((v >> 48) & 0xFFFF), imm(48));
+}
+#endif
+
+static void write_patch_list(Writer &w,
+                             CodeHolder &code,
+                             const std::vector<BeamModuleAssemblerCommon::patch>
+                                     &patches) {
+    w.u32(patches.size());
+    for (const auto &p : patches) {
+        size_t off = code.label_offset_from_base(p.where) + p.ptr_offs;
+        w.u32(off);
+        w.u32(p.val_offs);
+    }
+}
+
+static bool covered(const std::vector<BeamAssemblerCommon::JitcReloc> &rs,
+                    uint32_t off) {
+    for (const auto &r : rs) {
+        if (r.off == off) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void unrelocated(Eterm mod, uint64_t value, size_t off) {
+    Dl_info info;
+    const char *sym = "?";
+    if (dladdr((void *)value, &info) && info.dli_sname) {
+        sym = info.dli_sname;
+    }
+    erts_exit(ERTS_ERROR_EXIT,
+              "jitc: unrelocated address %p (%s) at offset %lu in module %T\n",
+              (void *)value,
+              sym,
+              (unsigned long)off,
+              mod);
+}
+
+/* Every address in the text must have a relocation: on AArch64 movz/movk
+ * sequences must come from mov_ptr(); on x86 the immediates of mov are
+ * collected here. Tagged immediates have their low bits set. */
+static void collect_immediates(Eterm mod,
+                               const std::vector<byte> &snapshot,
+                               size_t text_size,
+                               std::vector<BeamAssemblerCommon::JitcReloc> &rs) {
+    const byte *text = snapshot.data();
+    size_t i;
+    PtrClass pc;
+
+#if defined(__aarch64__)
+    for (i = 0; i + 4 <= text_size; i += 4) {
+        uint32_t w = rd_u32(text + i);
+
+        if ((w & 0xFF800000) == 0xD2800000) {
+            unsigned rd = w & 0x1F;
+            uint64_t value = (uint64_t)((w >> 5) & 0xFFFF)
+                             << (16 * ((w >> 21) & 3));
+            size_t j = i + 4;
+
+            while (j + 4 <= text_size) {
+                uint32_t k = rd_u32(text + j);
+                if ((k & 0xFF800000) != 0xF2800000 || (k & 0x1F) != rd) {
+                    break;
+                }
+                value |= (uint64_t)((k >> 5) & 0xFFFF) << (16 * ((k >> 21) & 3));
+                j += 4;
+            }
+            if (value >= 0x10000 && (value & 3) == 0 &&
+                classify_ptr(value, pc) && !covered(rs, i)) {
+                unrelocated(mod, value, i);
+            }
+        }
+    }
+#elif defined(__x86_64__)
+    for (i = 0; i + 2 <= text_size;) {
+        unsigned rex = (text[i] & 0xF0) == 0x40 ? text[i] : 0;
+        size_t op = rex ? i + 1 : i;
+
+        if (op < text_size && (text[op] & 0xF8) == 0xB8) {
+            /* mov r64, imm64 (REX.W) or mov r32, imm32 */
+            size_t imm = op + 1;
+            unsigned width = (rex & 0x08) ? 8 : 4;
+            uint64_t value;
+
+            if (imm + width <= text_size) {
+                value = width == 8 ? rd_u64(text + imm) : rd_u32(text + imm);
+                if (value >= 0x10000 && (value & 3) == 0 &&
+                    classify_ptr(value, pc)) {
+                    BeamAssemblerCommon::JitcReloc r;
+                    r.type = width == 8 ? JITC_R_ABS64 : JITC_R_ABS32;
+                    r.kind = pc.kind;
+                    r.off = imm;
+                    r.end = imm + width;
+                    r.value = pc.value;
+                    r.name = pc.name;
+                    rs.push_back(std::move(r));
+                    i = imm + width;
+                    continue;
+                }
+            }
+        }
+        i++;
+    }
+#endif
+
+    for (i = 0; i + 8 <= text_size; i += 8) {
+        uint64_t value = rd_u64(text + i);
+
+        if (value >= 0x100000000ULL && value < 0x800000000000ULL &&
+            (value & 3) == 0 && classify_ptr(value, pc) && !covered(rs, i)) {
+            unrelocated(mod, value, i);
+        }
+    }
+}
+
+std::vector<byte> BeamModuleAssembler::jitc_serialize(
+        const BeamJitcRecordInfo *stp) {
+    Writer w;
+    unsigned char uuid[16];
+
+    ERTS_ASSERT(erts_aot_recording && !jitc_snapshot.empty());
+
+    erts_aot_emulator_uuid(uuid);
+
+    w.bytes(JITC_MAGIC, 8);
+    w.bytes(uuid, 16);
+    w.bytes(erts_aot_build_id, 16);
+    w.u32(0); /* flags */
+
+    w.bytes(stp->beam->checksum, 16);
+
+    w.u32(stp->beam->atoms.count);
+    for (Sint32 i = 0; i < stp->beam->atoms.count; i++) {
+        Eterm atom = stp->beam->atoms.entries[i];
+        w.u32(is_atom(atom) ? (uint32_t)atom_val(atom) : 0xFFFFFFFFu);
+    }
+
+    w.u32(jitc_snapshot.size());
+    w.u32(a.offset()); /* module (text) size */
+    w.u32(jitc_addrtab_off);
+    w.u32(code.label_offset_from_base(code_header));
+    w.u32(code.label_offset_from_base(code_end));
+    if (on_load.is_valid()) {
+        w.i32(code.label_offset_from_base(on_load));
+    } else {
+        w.i32(-1);
+    }
+
+    /* BEAM labels */
+    {
+        unsigned n = stp->beam->code.label_count;
+        w.u32(n);
+        for (unsigned i = 0; i < n; i++) {
+            auto it = rawLabels.find(i);
+            if (it == rawLabels.end() || !code.is_label_bound(it->second)) {
+                w.u32(0xFFFFFFFFu);
+            } else {
+                w.u32(code.label_offset_from_base(it->second));
+            }
+        }
+    }
+
+    /* Functions */
+    w.u32(functions.size());
+    for (auto label : functions) {
+        w.u32(label);
+    }
+
+    /* Lambda trampolines */
+    {
+        unsigned n = stp->beam->lambdas.count;
+        w.u32(n);
+        for (unsigned i = 0; i < n; i++) {
+            w.u32(code.label_offset_from_base(lambdas[i].trampoline));
+        }
+    }
+
+    /* Named labels (rodata/bss tables) */
+    {
+        static const char *names[] =
+                {"line", "debug", "str", "attr", "compile", "md5"};
+        std::vector<std::pair<std::string, uint32_t>> named;
+        for (const char *name : names) {
+            Label l = code.label_by_name(name, strlen(name));
+            if (l.is_valid() && code.is_label_bound(l)) {
+                named.push_back({std::string(name),
+                                 (uint32_t)code.label_offset_from_base(l)});
+            }
+        }
+        w.u32(named.size());
+        for (auto &n : named) {
+            w.u8(n.first.size());
+            w.bytes(n.first.data(), n.first.size());
+            w.u32(n.second);
+        }
+    }
+
+    /* Relocations */
+    {
+        std::vector<JitcReloc> rs = jitc_relocs;
+
+#ifdef __aarch64__
+        for (auto &pr : jitc_ptr_relocs) {
+            JitcReloc r;
+            r.type = JITC_R_MOVSEQ;
+            r.off = pr.offset;
+            r.end = pr.offset + 16;
+            classify_or_die(mod, (uintptr_t)pr.target, r);
+            rs.push_back(std::move(r));
+        }
+
+        for (auto &kv : _constants) {
+            const Constant &c = kv.second;
+            uintptr_t v;
+            PtrClass pc;
+
+            if (!c.value.isWord() || !code.is_label_bound(c.anchor)) {
+                continue;
+            }
+            v = c.value.as<ArgWord>().get();
+            if (v < 0x100000000ULL || (v & 3) != 0 || !classify_ptr(v, pc)) {
+                continue;
+            }
+            JitcReloc r;
+            r.type = JITC_R_ABS64;
+            r.off = code.label_offset_from_base(c.anchor);
+            r.end = r.off + 8;
+            r.kind = pc.kind;
+            r.value = pc.value;
+            r.name = pc.name;
+            rs.push_back(std::move(r));
+        }
+#endif
+
+        collect_immediates(mod, jitc_snapshot, a.offset(), rs);
+
+        w.u32(rs.size());
+        for (auto &r : rs) {
+            w.u8(r.type);
+            w.u8(r.kind);
+            w.u32(r.off);
+            w.u32(r.end);
+            w.u64(r.value);
+            w.str(r.name);
+        }
+    }
+
+    /* Loader patches */
+    w.u32(literals.size());
+    for (auto &kv : literals) {
+        w.i32((int32_t)kv.first);
+        write_patch_list(w, code, kv.second.patches);
+    }
+
+    w.u32(imports.size());
+    for (auto &kv : imports) {
+        w.u32(kv.first);
+        write_patch_list(w, code, kv.second.patches);
+    }
+
+    w.u32(lambdas.size());
+    for (auto &kv : lambdas) {
+        w.u32(kv.first);
+        write_patch_list(w, code, kv.second.patches);
+    }
+
+    write_patch_list(w, code, strings);
+
+    w.u32(catches.size());
+    for (auto &c : catches) {
+        w.u32(code.label_offset_from_base(c.patch.where) + c.patch.ptr_offs);
+        w.u32(code.label_offset_from_base(c.handler));
+    }
+
+    /* Loader state gathered while emitting instructions. */
+    w.u32(stp->current_li);
+    for (unsigned i = 0; i < stp->current_li; i++) {
+        w.i32(stp->line_instr[i][0]);
+        w.i32(stp->line_instr[i][1]);
+    }
+
+    if (stp->func_line) {
+        w.u32(stp->beam->code.function_count);
+        for (int i = 0; i < stp->beam->code.function_count; i++) {
+            w.u32(stp->func_line[i]);
+        }
+    } else {
+        w.u32(0);
+    }
+
+    if (stp->are_nifs) {
+        w.u8(1);
+        w.u32(stp->beam->code.function_count);
+        w.bytes(stp->are_nifs, stp->beam->code.function_count);
+    } else {
+        w.u8(0);
+    }
+
+    w.u32(stp->beam->debug.item_count);
+    for (Uint i = 0; i < stp->beam->debug.item_count; i++) {
+        w.i32(stp->beam->debug.items[i].location_index);
+    }
+
+    w.u32(stp->function_number);
+
+    /* Dynamic literals: lambda placeholders by index, the rest as ext terms */
+    {
+        const BeamFile_LiteralTable *dyn = &stp->beam->dynamic_literals;
+
+        w.u32(stp->dyn_base);
+        w.u32(dyn->count - stp->dyn_base);
+        for (Sint32 i = stp->dyn_base; i < dyn->count; i++) {
+            Eterm term = dyn->entries[i].value;
+            int lambda = -1;
+
+            for (Sint32 j = 0; j < stp->beam->lambdas.count; j++) {
+                if (stp->lambda_literals[j] == ~(SWord)i) {
+                    lambda = j;
+                    break;
+                }
+            }
+
+            if (lambda >= 0) {
+                w.u8(1);
+                w.u32(lambda);
+            } else {
+                Uint size;
+                std::vector<byte> ext;
+                byte *p;
+
+                if (erts_encode_ext_size(term, &size) != ERTS_EXT_SZ_OK) {
+                    erts_exit(ERTS_ERROR_EXIT,
+                              "jitc: cannot encode dynamic literal %T in %T\n",
+                              term,
+                              mod);
+                }
+                ext.resize(size);
+                p = ext.data();
+                erts_encode_ext(term, &p);
+
+                w.u8(0);
+                w.u32(p - ext.data());
+                w.bytes(ext.data(), p - ext.data());
+            }
+        }
+    }
+
+    /* Code */
+    w.bytes(jitc_snapshot.data(), jitc_snapshot.size());
+
+    return std::move(w.buf);
+}
+
+struct RecordedModule {
+    std::string name;
+    std::vector<byte> data;
+};
+
+static std::vector<RecordedModule> recorded;
+static std::mutex recorded_mutex;
+
+static inline uint32_t be32(const byte *p) {
+    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) |
+           ((uint32_t)p[2] << 8) | p[3];
+}
+
+static void put_be32(byte *p, uint32_t v) {
+    p[0] = v >> 24;
+    p[1] = v >> 16;
+    p[2] = v >> 8;
+    p[3] = v;
+}
+
+int beamjitc_record_module(void *instance, const BeamJitcRecordInfo *stp) {
+    BeamModuleAssembler *ba = static_cast<BeamModuleAssembler *>(instance);
+    std::vector<byte> chunk = ba->jitc_serialize(stp);
+    const byte *src = stp->src_code;
+    size_t src_size = stp->src_size;
+    RecordedModule rec;
+    size_t form_end, padded;
+
+    if (src_size < 12 || memcmp(src, "FOR1", 4) != 0 ||
+        memcmp(src + 8, "BEAM", 4) != 0) {
+        erts_exit(ERTS_ERROR_EXIT,
+                  "jitc: module %T is not a plain FOR1/BEAM file\n",
+                  stp->module);
+    }
+
+    form_end = 8 + be32(src + 4);
+    if (form_end > src_size) {
+        form_end = src_size;
+    }
+
+    /* The chunks of the file, less any JITC chunk it already has */
+    rec.data.assign(src, src + 12);
+    for (size_t pos = 12; pos + 8 <= form_end;) {
+        size_t size = be32(src + pos + 4);
+        size_t next = pos + 8 + ((size + 3) & ~(size_t)3);
+        if (next > form_end) {
+            next = form_end;
+        }
+        if (memcmp(src + pos, "JITC", 4) != 0) {
+            rec.data.insert(rec.data.end(), src + pos, src + next);
+        }
+        pos = next;
+    }
+    while (rec.data.size() % 4 != 0) {
+        rec.data.push_back(0);
+    }
+
+    rec.data.insert(rec.data.end(), {'J', 'I', 'T', 'C'});
+    {
+        byte sz[4];
+        put_be32(sz, chunk.size());
+        rec.data.insert(rec.data.end(), sz, sz + 4);
+    }
+    rec.data.insert(rec.data.end(), chunk.begin(), chunk.end());
+    padded = rec.data.size();
+    while (padded % 4 != 0) {
+        rec.data.push_back(0);
+        padded++;
+    }
+
+    put_be32(rec.data.data() + 4, rec.data.size() - 8);
+
+    {
+        Atom *ap = atom_tab(atom_val(stp->module));
+        rec.name.assign((const char *)erts_atom_get_name(ap), ap->len);
+    }
+
+    std::lock_guard<std::mutex> lock(recorded_mutex);
+    recorded.push_back(std::move(rec));
+    return 1;
+}
+
+int beamjitc_recorded_count(void) {
+    std::lock_guard<std::mutex> lock(recorded_mutex);
+    return recorded.size();
+}
+
+int beamjitc_recorded_get(int i,
+                         char *name_out,
+                         size_t name_size,
+                         const byte **data,
+                         size_t *size) {
+    std::lock_guard<std::mutex> lock(recorded_mutex);
+    if (i < 0 || (size_t)i >= recorded.size()) {
+        return 0;
+    }
+    erts_snprintf(name_out, name_size, "%s", recorded[i].name.c_str());
+    *data = recorded[i].data.data();
+    *size = recorded[i].data.size();
+    return 1;
+}
+
+/* ------------------------------------------------------------------------
+ * Replay
+ * ------------------------------------------------------------------------ */
+
+static void check_chunk_identity(Reader &r);
+
+struct JitcPatch {
+    uint32_t offset;
+    uint32_t val_offs;
+};
+
+struct JitcPatchList {
+    int32_t index = 0;
+    const byte *patches = nullptr; /* JitcPatch[count] */
+    uint32_t count = 0;
+};
+
+struct BeamJitcModule {
+    Eterm mod;
+
+    const byte *chunk;
+    size_t chunk_size;
+
+    uint32_t code_size;
+    uint32_t module_size;
+    uint32_t code_header_off;
+    uint32_t code_end_off;
+    int32_t on_load_off;
+
+    uint32_t label_count;
+    const byte *label_offs; /* u32[label_count] */
+    uint32_t function_count;
+    const byte *function_labels; /* u32[function_count] */
+    uint32_t lambda_count;
+    const byte *lambda_offs; /* u32[lambda_count] */
+
+    std::vector<std::pair<std::string, uint32_t>> named;
+
+    uint32_t addrtab_off;
+
+    struct Reloc {
+        uint8_t type;
+        uint8_t kind;
+        uint32_t off;
+        uint32_t end;
+        uint64_t value;
+        std::string name;
+    };
+    std::vector<Reloc> relocs;
+
+    std::vector<JitcPatchList> literal_patches;
+    std::vector<JitcPatchList> dyn_literal_patches;
+    std::vector<JitcPatchList> import_patches;
+    std::vector<JitcPatchList> lambda_patches;
+    JitcPatchList string_patches;
+    uint32_t catch_count;
+    const byte *catches; /* {u32 off, u32 handler_off}[] */
+
+    /* Loader state */
+    uint32_t line_count;
+    const byte *line_instrs; /* {i32 pos, i32 loc}[] */
+    uint32_t func_line_count;
+    const byte *func_lines; /* u32[] */
+    uint8_t has_nifs;
+    uint32_t are_nifs_count;
+    const byte *are_nifs;
+    uint32_t debug_item_count;
+    const byte *debug_locs; /* i32[] */
+    uint32_t function_number;
+
+    uint32_t dyn_base;
+    uint32_t dyn_count;
+    const byte *dyn_data; /* parsed by restore_loader_state */
+    size_t dyn_size;
+
+    const byte *code; /* code_size bytes, valid only until codegen */
+    size_t code_off;  /* offset of the code within the chunk */
+
+    /* The BEAM binary is freed before finish_loading, so the tables are
+     * copied. */
+    std::vector<byte> owned;
+
+    /* After codegen */
+    const char *exec_base = nullptr;
+    char *rw_base = nullptr;
+
+    bool parse(Reader &r, bool with_code);
+};
+
+static bool read_patch_list(Reader &r, JitcPatchList &out, int32_t index) {
+    out.index = index;
+    out.count = r.u32();
+    out.patches = r.bytes((size_t)out.count * 8);
+    return r.ok;
+}
+
+bool BeamJitcModule::parse(Reader &r, bool with_code) {
+    const byte *start = r.p;
+    uint32_t n;
+
+    check_chunk_identity(r);
+
+    (void)r.u32(); /* flags */
+    (void)r.bytes(16); /* checksum */
+
+    {
+        uint32_t n = r.u32();
+        const byte *idx = r.bytes((size_t)n * 4);
+        uint32_t max = 0;
+
+        if (idx == nullptr) {
+            return false;
+        }
+        for (uint32_t i = 0; i < n; i++) {
+            uint32_t v = rd_u32(idx + (size_t)i * 4);
+            if (v != 0xFFFFFFFFu && v > max) {
+                max = v;
+            }
+        }
+        if (max >= erts_aot_atom_count()) {
+            erts_exit(ERTS_ERROR_EXIT,
+                      "jitc: module needs atom %u, beyond the snapshot\n",
+                      max);
+        }
+    }
+
+    code_size = r.u32();
+    module_size = r.u32();
+    addrtab_off = r.u32();
+    code_header_off = r.u32();
+    code_end_off = r.u32();
+    on_load_off = r.i32();
+
+    label_count = r.u32();
+    label_offs = r.bytes((size_t)label_count * 4);
+    function_count = r.u32();
+    function_labels = r.bytes((size_t)function_count * 4);
+    lambda_count = r.u32();
+    lambda_offs = r.bytes((size_t)lambda_count * 4);
+
+    n = r.u32();
+    for (uint32_t i = 0; i < n && r.ok; i++) {
+        unsigned len = r.u8();
+        const byte *s = r.bytes(len);
+        uint32_t off = r.u32();
+        if (s) {
+            named.push_back({std::string((const char *)s, len), off});
+        }
+    }
+
+    n = r.u32();
+    relocs.reserve(n);
+    for (uint32_t i = 0; i < n && r.ok; i++) {
+        Reloc rl;
+        unsigned len;
+        const byte *s;
+
+        rl.type = r.u8();
+        rl.kind = r.u8();
+        rl.off = r.u32();
+        rl.end = r.u32();
+        rl.value = r.u64();
+        len = r.u16();
+        s = r.bytes(len);
+        if (s && len) {
+            rl.name.assign((const char *)s, len);
+        }
+        relocs.push_back(std::move(rl));
+    }
+
+    n = r.u32();
+    for (uint32_t i = 0; i < n && r.ok; i++) {
+        int32_t index = r.i32();
+        JitcPatchList list;
+        read_patch_list(r, list, index);
+        if (index >= 0) {
+            if ((size_t)index >= literal_patches.size()) {
+                literal_patches.resize(index + 1);
+            }
+            literal_patches[index] = list;
+        } else {
+            if ((size_t)~index >= dyn_literal_patches.size()) {
+                dyn_literal_patches.resize(~index + 1);
+            }
+            dyn_literal_patches[~index] = list;
+        }
+    }
+
+    n = r.u32();
+    for (uint32_t i = 0; i < n && r.ok; i++) {
+        uint32_t index = r.u32();
+        JitcPatchList list;
+        read_patch_list(r, list, index);
+        if (index >= import_patches.size()) {
+            import_patches.resize(index + 1);
+        }
+        import_patches[index] = list;
+    }
+
+    n = r.u32();
+    for (uint32_t i = 0; i < n && r.ok; i++) {
+        uint32_t index = r.u32();
+        JitcPatchList list;
+        read_patch_list(r, list, index);
+        if (index >= lambda_patches.size()) {
+            lambda_patches.resize(index + 1);
+        }
+        lambda_patches[index] = list;
+    }
+
+    read_patch_list(r, string_patches, 0);
+
+    catch_count = r.u32();
+    catches = r.bytes((size_t)catch_count * 8);
+
+    line_count = r.u32();
+    line_instrs = r.bytes((size_t)line_count * 8);
+    func_line_count = r.u32();
+    func_lines = r.bytes((size_t)func_line_count * 4);
+    has_nifs = r.u8();
+    if (has_nifs) {
+        are_nifs_count = r.u32();
+        are_nifs = r.bytes(are_nifs_count);
+    } else {
+        are_nifs_count = 0;
+        are_nifs = nullptr;
+    }
+    debug_item_count = r.u32();
+    debug_locs = r.bytes((size_t)debug_item_count * 4);
+    function_number = r.u32();
+
+    dyn_base = r.u32();
+    dyn_count = r.u32();
+    dyn_data = r.p;
+    for (uint32_t i = 0; i < dyn_count && r.ok; i++) {
+        if (r.u8() == 1) {
+            (void)r.u32();
+        } else {
+            uint32_t size = r.u32();
+            (void)r.bytes(size);
+        }
+    }
+    dyn_size = r.p - dyn_data;
+
+    code_off = r.p - start;
+    if (with_code) {
+        code = r.bytes(code_size);
+    } else {
+        code = nullptr;
+    }
+
+    return r.ok;
+}
+
+static void check_chunk_identity(Reader &r) {
+    const byte *magic, *uuid, *id;
+    unsigned char emu_uuid[16];
+
+    ERTS_ASSERT(erts_aot_active);
+
+    magic = r.bytes(8);
+    uuid = r.bytes(16);
+    id = r.bytes(16);
+    if (!r.ok || memcmp(magic, JITC_MAGIC, 8) != 0) {
+        erts_exit(ERTS_ERROR_EXIT, "jitc: corrupt JITC chunk header\n");
+    }
+    erts_aot_emulator_uuid(emu_uuid);
+    if (memcmp(uuid, emu_uuid, 16) != 0) {
+        erts_exit(ERTS_ERROR_EXIT,
+                  "jitc: the module was compiled for another emulator build\n");
+    }
+    if (memcmp(id, erts_aot_build_id, 16) != 0) {
+        erts_exit(ERTS_ERROR_EXIT,
+                  "jitc: the module was compiled for another executable\n");
+    }
+}
+
+int beamjitc_atom_indices(const byte *chunk,
+                         Sint32 size,
+                         const Uint32 **indices,
+                         Uint32 *count,
+                         const byte **checksum) {
+    Reader r(chunk, size);
+    const byte *sum;
+    uint32_t n, max = 0;
+    const byte *idx;
+
+    if (size <= 0 || !erts_aot_active) {
+        return 0; /* No JITC chunk, or not the executable it was made for. */
+    }
+
+    check_chunk_identity(r);
+    (void)r.u32();
+    sum = r.bytes(16);
+    n = r.u32();
+    idx = r.bytes((size_t)n * 4);
+    if (idx == nullptr || n == 0) {
+        erts_exit(ERTS_ERROR_EXIT, "jitc: corrupt atom table in JITC chunk\n");
+    }
+    for (uint32_t i = 0; i < n; i++) {
+        uint32_t v = rd_u32(idx + (size_t)i * 4);
+        if (v != 0xFFFFFFFFu && v > max) {
+            max = v;
+        }
+    }
+    if (max >= erts_aot_atom_count()) {
+        erts_exit(ERTS_ERROR_EXIT,
+                  "jitc: module needs atom %u, beyond the snapshot\n",
+                  max);
+    }
+    *indices = (const Uint32 *)idx;
+    *count = n;
+    *checksum = sum;
+    return 1;
+}
+
+void *beamjitc_new(Eterm module, const BeamFile *beam) {
+    BeamJitcModule *m;
+    Reader r(beam->jitc.data, beam->jitc.size);
+
+    if (beam->jitc.size == 0 || !erts_aot_active) {
+        return nullptr; /* No JITC chunk to use: generate the code. */
+    }
+
+    if (erts_coverage_mode != ERTS_COV_NONE ||
+        (beam->lines.flags & BEAMFILE_FORCE_LINE_COUNTERS)) {
+        erts_exit(ERTS_ERROR_EXIT,
+                  "jitc: coverage is not supported with JITC chunks "
+                  "(module %T)\n",
+                  module);
+    }
+
+    m = new BeamJitcModule();
+    m->mod = module;
+    m->chunk = beam->jitc.data;
+    m->chunk_size = beam->jitc.size;
+
+    if (m->parse(r, true)) {
+        const byte *code = m->code;
+        m->owned.assign(beam->jitc.data, beam->jitc.data + m->code_off);
+        m->named.clear();
+        m->relocs.clear();
+        m->literal_patches.clear();
+        m->dyn_literal_patches.clear();
+        m->import_patches.clear();
+        m->lambda_patches.clear();
+        Reader r2(m->owned.data(), m->owned.size());
+        if (!m->parse(r2, false)) {
+            r.ok = false;
+        }
+        m->code = code;
+    } else {
+        r.ok = false;
+    }
+
+    if (!r.ok || m->label_count != (uint32_t)beam->code.label_count ||
+        m->function_count != (uint32_t)beam->code.function_count ||
+        m->lambda_count != (uint32_t)beam->lambdas.count ||
+        m->debug_item_count != (uint32_t)beam->debug.item_count) {
+        erts_exit(ERTS_ERROR_EXIT,
+                  "jitc: corrupt JITC chunk in module %T (does not match the "
+                  "module's code)\n",
+                  module);
+    }
+
+    return m;
+}
+
+void beamjitc_delete(void *inst) {
+    delete static_cast<BeamJitcModule *>(inst);
+}
+
+int beamjitc_restore_loader_state(void *inst, const BeamJitcRestoreInfo *r) {
+    BeamJitcModule *m = static_cast<BeamJitcModule *>(inst);
+    const BeamFile *beam = r->beam;
+
+    if (m->line_count > 0) {
+        if (r->line_instr == nullptr ||
+            m->line_count > (uint32_t)beam->lines.instruction_count) {
+            return 0;
+        }
+        for (uint32_t i = 0; i < m->line_count; i++) {
+            r->line_instr[i][0] = (int)rd_u32(m->line_instrs + i * 8);
+            r->line_instr[i][1] = (int)rd_u32(m->line_instrs + i * 8 + 4);
+        }
+    }
+    *r->current_li = m->line_count;
+
+    if (m->func_line_count > 0) {
+        if (r->func_line == nullptr ||
+            m->func_line_count != (uint32_t)beam->code.function_count) {
+            return 0;
+        }
+        for (uint32_t i = 0; i < m->func_line_count; i++) {
+            r->func_line[i] = rd_u32(m->func_lines + i * 4);
+        }
+    }
+
+    *r->has_nifs = 0;
+    if (m->has_nifs) {
+        if (m->are_nifs_count != (uint32_t)beam->code.function_count) {
+            return 0;
+        }
+        sys_memcpy(r->are_nifs, m->are_nifs, m->are_nifs_count);
+        *r->has_nifs = 1;
+    }
+
+    for (uint32_t i = 0; i < m->debug_item_count; i++) {
+        r->beam->debug.items[i].location_index =
+                (Sint32)rd_u32(m->debug_locs + i * 4);
+    }
+
+    *r->function_number = m->function_number;
+
+    {
+        Reader dr(m->dyn_data, m->dyn_size);
+
+        if ((uint32_t)beam->dynamic_literals.count != m->dyn_base) {
+            return 0;
+        }
+
+        for (uint32_t i = m->dyn_base; i < m->dyn_base + m->dyn_count; i++) {
+            Sint index;
+
+            if (dr.u8() == 1) {
+                uint32_t lambda = dr.u32();
+                const BeamFile_LambdaEntry *entry;
+                Eterm tmp_hp[ERL_FUN_SIZE];
+                ErlFunThing *funp = (ErlFunThing *)tmp_hp;
+
+                if (lambda >= (uint32_t)beam->lambdas.count) {
+                    return 0;
+                }
+                entry = &beam->lambdas.entries[lambda];
+
+                funp->thing_word = MAKE_FUN_HEADER(entry->arity, 0, 0);
+                funp->entry.exp = nullptr;
+
+                index = beamfile_add_literal(r->beam, make_fun(tmp_hp), 0);
+                r->lambda_literals[lambda] = index;
+            } else {
+                uint32_t size = dr.u32();
+                const byte *ext = dr.bytes(size);
+                const byte *p = ext;
+                ErtsHeapFactory factory;
+                Sint heap_size;
+                Eterm *hp;
+                Eterm term;
+
+                if (ext == nullptr) {
+                    return 0;
+                }
+                heap_size = erts_decode_ext_size(ext, size);
+                if (heap_size < 0) {
+                    return 0;
+                }
+                hp = (Eterm *)erts_alloc(ERTS_ALC_T_TMP,
+                                         (heap_size + 1) * sizeof(Eterm));
+                erts_factory_tmp_init(&factory, hp, heap_size, ERTS_ALC_T_TMP);
+                term = erts_decode_ext(&factory, &p, 0);
+                if (is_non_value(term)) {
+                    erts_factory_undo(&factory);
+                    erts_free(ERTS_ALC_T_TMP, hp);
+                    return 0;
+                }
+                index = beamfile_add_literal(r->beam, term, 0);
+                erts_factory_close(&factory);
+                erts_cleanup_offheap(factory.off_heap);
+                erts_free(ERTS_ALC_T_TMP, hp);
+            }
+
+            if (index != ~(Sint)i) {
+                return 0;
+            }
+        }
+    }
+
+    return 1;
+}
+
+static inline uint32_t label_off(BeamJitcModule *m, unsigned label) {
+    ERTS_ASSERT(label < m->label_count);
+    return rd_u32(m->label_offs + (size_t)label * 4);
+}
+
+static void patch_mov_sequence(char *rw, uint32_t off, uint64_t v) {
+    for (int i = 0; i < 4; i++) {
+        uint32_t w = rd_u32((const byte *)rw + off + i * 4);
+        w = (w & ~(0xFFFFu << 5)) | ((uint32_t)((v >> (16 * i)) & 0xFFFF) << 5);
+        memcpy(rw + off + i * 4, &w, 4);
+    }
+}
+
+static void wr_u32(char *p, uint32_t v) {
+    memcpy(p, &v, 4);
+}
+
+static void wr_u64(char *p, uint64_t v) {
+    memcpy(p, &v, 8);
+}
+
+/* Applies the relocations as asmjit's relocate_to_base() would. */
+static void apply_relocs(BeamJitcModule *m, char *rw, uintptr_t base) {
+    std::unordered_map<uint64_t, uint32_t> slots;
+
+    for (const auto &r : m->relocs) {
+        uint64_t target = 0;
+        int64_t rel;
+
+        if (r.type != JITC_R_ABS64_MODULE && r.type != JITC_R_REL32_MODULE) {
+            target = resolve_ptr(r.kind, r.value, r.name.c_str());
+        }
+
+        switch (r.type) {
+        case JITC_R_ABS64_MODULE:
+            wr_u64(rw + r.off, base + r.value);
+            break;
+        case JITC_R_REL32_MODULE:
+            wr_u32(rw + r.off, (uint32_t)((int64_t)r.value - (int64_t)r.end));
+            break;
+        case JITC_R_REL32:
+        case JITC_R_ADDRENTRY:
+            rel = (int64_t)target - (int64_t)(base + r.end);
+            if (rel != (int32_t)rel) {
+                uint32_t slot;
+                auto it = slots.find(target);
+
+                if (r.type != JITC_R_ADDRENTRY ||
+                    m->addrtab_off == 0xFFFFFFFFu) {
+                    erts_exit(ERTS_ERROR_EXIT,
+                              "jitc: address %p out of range in module %T\n",
+                              (void *)target,
+                              m->mod);
+                }
+                if (it == slots.end()) {
+                    slot = slots.size();
+                    slots[target] = slot;
+                    wr_u64(rw + m->addrtab_off + (size_t)slot * 8, target);
+                } else {
+                    slot = it->second;
+                }
+                /* call/jmp rel32 becomes call/jmp [rip + rel32] */
+                if ((byte)rw[r.off - 1] == 0xE8) {
+                    rw[r.off - 1] = 0x15;
+                } else if ((byte)rw[r.off - 1] == 0xE9) {
+                    rw[r.off - 1] = 0x25;
+                } else {
+                    erts_exit(ERTS_ERROR_EXIT,
+                              "jitc: bad address table instruction in "
+                              "module %T\n",
+                              m->mod);
+                }
+                rw[r.off - 2] = (char)0xFF;
+                rel = (int64_t)(m->addrtab_off + (uint64_t)slot * 8) -
+                      (int64_t)r.end;
+            }
+            wr_u32(rw + r.off, (uint32_t)rel);
+            break;
+        case JITC_R_MOVSEQ:
+            patch_mov_sequence(rw, r.off, target);
+            break;
+        case JITC_R_ABS64:
+            wr_u64(rw + r.off, target);
+            break;
+        case JITC_R_ABS32:
+            if (target > 0xFFFFFFFFu) {
+                erts_exit(ERTS_ERROR_EXIT,
+                          "jitc: address %p does not fit in 32 bits in "
+                          "module %T\n",
+                          (void *)target,
+                          m->mod);
+            }
+            wr_u32(rw + r.off, (uint32_t)target);
+            break;
+        default:
+            erts_exit(ERTS_ERROR_EXIT,
+                      "jitc: bad relocation type %d in module %T\n",
+                      r.type,
+                      m->mod);
+        }
+    }
+}
+
+void beamjitc_codegen(void *inst,
+                     const void **executable_region,
+                     void **writable_region,
+                     const BeamCodeHeader *in_hdr,
+                     const BeamCodeHeader **out_exec_hdr,
+                     BeamCodeHeader **out_rw_hdr) {
+    BeamJitcModule *m = static_cast<BeamJitcModule *>(inst);
+    JitAllocator *allocator = beamasm_jit_allocator();
+    JitAllocator::Span span;
+    BeamCodeHeader *hdr_rw;
+    uintptr_t base;
+    char *rw;
+    Error err;
+
+    Out<JitAllocator::Span> out(span);
+    err = allocator->alloc(out, m->code_size + 16);
+    ERTS_ASSERT(err == Error::kOk && "Failed to allocate module code");
+
+    *executable_region = span.rx();
+    *writable_region = span.rw();
+
+    VirtMem::protect_jit_memory(VirtMem::ProtectJitAccess::kReadWrite);
+
+    m->exec_base = (const char *)span.rx();
+    m->rw_base = rw = (char *)span.rw();
+    base = (uintptr_t)m->exec_base;
+
+    sys_memcpy(rw, m->code, m->code_size);
+    apply_relocs(m, rw, base);
+
+    hdr_rw = (BeamCodeHeader *)(rw + m->code_header_off);
+    sys_memcpy(hdr_rw, in_hdr, sizeof(BeamCodeHeader));
+    hdr_rw->on_load = beamjitc_get_on_load(inst);
+
+    for (uint32_t i = 0; i < m->function_count; i++) {
+        unsigned label = rd_u32(m->function_labels + (size_t)i * 4);
+        hdr_rw->functions[i] =
+                (ErtsCodeInfo *)(m->exec_base + label_off(m, label));
+    }
+    hdr_rw->functions[m->function_count] =
+            (ErtsCodeInfo *)(m->exec_base + m->module_size);
+
+    *out_exec_hdr = (const BeamCodeHeader *)(m->exec_base + m->code_header_off);
+    *out_rw_hdr = hdr_rw;
+}
+
+ErtsCodePtr beamjitc_get_code(void *inst, int label) {
+    BeamJitcModule *m = static_cast<BeamJitcModule *>(inst);
+    uint32_t off = label_off(m, label);
+    ERTS_ASSERT(off != 0xFFFFFFFFu);
+    return (ErtsCodePtr)(m->exec_base + off);
+}
+
+ErtsCodePtr beamjitc_get_lambda(void *inst, int index) {
+    BeamJitcModule *m = static_cast<BeamJitcModule *>(inst);
+    ERTS_ASSERT((uint32_t)index < m->lambda_count);
+    return (ErtsCodePtr)(m->exec_base +
+                         rd_u32(m->lambda_offs + (size_t)index * 4));
+}
+
+const byte *beamjitc_get_rodata(void *inst, const char *label) {
+    BeamJitcModule *m = static_cast<BeamJitcModule *>(inst);
+    for (auto &n : m->named) {
+        if (n.first == label) {
+            return (const byte *)(m->exec_base + n.second);
+        }
+    }
+    erts_exit(ERTS_ERROR_EXIT, "jitc: no rodata label %s in %T\n", label, m->mod);
+    return nullptr;
+}
+
+Uint beamjitc_get_header(void *inst, const BeamCodeHeader **hdr) {
+    BeamJitcModule *m = static_cast<BeamJitcModule *>(inst);
+    *hdr = (const BeamCodeHeader *)(m->exec_base + m->code_header_off);
+    return m->code_size;
+}
+
+char *beamjitc_get_base(void *inst) {
+    BeamJitcModule *m = static_cast<BeamJitcModule *>(inst);
+    return (char *)m->exec_base;
+}
+
+size_t beamjitc_get_offset(void *inst) {
+    BeamJitcModule *m = static_cast<BeamJitcModule *>(inst);
+    return m->module_size;
+}
+
+const ErtsCodeInfo *beamjitc_get_on_load(void *inst) {
+    BeamJitcModule *m = static_cast<BeamJitcModule *>(inst);
+    if (m->on_load_off < 0) {
+        return nullptr;
+    }
+    return erts_code_to_codeinfo((ErtsCodePtr)(m->exec_base + m->on_load_off));
+}
+
+unsigned int beamjitc_patch_catches(void *inst, char *rw_base) {
+    BeamJitcModule *m = static_cast<BeamJitcModule *>(inst);
+    unsigned catch_no = BEAM_CATCHES_NIL;
+
+    for (uint32_t i = 0; i < m->catch_count; i++) {
+        const byte *e = m->catches + (size_t)i * 8;
+        uint32_t off = rd_u32(e);
+        uint32_t handler_off = rd_u32(e + 4);
+        ErtsCodePtr handler = (ErtsCodePtr)(m->exec_base + handler_off);
+        Eterm catch_term;
+        int32_t *where;
+
+        catch_no = beam_catches_cons(handler, catch_no, nullptr);
+        catch_term = make_catch(catch_no);
+        ERTS_ASSERT(catch_term >> 31 == 0);
+
+        where = (int32_t *)&rw_base[off];
+        ASSERT(INT_MAX == *where);
+        *where = catch_term;
+    }
+
+    return catch_no;
+}
+
+static void apply_patches(const JitcPatchList &list, char *rw_base, Eterm value) {
+    for (uint32_t i = 0; i < list.count; i++) {
+        const byte *e = list.patches + (size_t)i * 8;
+        uint32_t off = rd_u32(e);
+        uint32_t val_offs = rd_u32(e + 4);
+        Eterm v = value + val_offs;
+
+        ASSERT(rd_u64((const byte *)rw_base + off) == (Uint64)LLONG_MAX);
+        memcpy(rw_base + off, &v, 8);
+    }
+}
+
+static const JitcPatchList *find_list(const std::vector<JitcPatchList> &lists,
+                                     uint32_t index) {
+    if (index < lists.size() && lists[index].count > 0) {
+        return &lists[index];
+    }
+    return nullptr;
+}
+
+void beamjitc_patch_import(void *inst,
+                          char *rw_base,
+                          int index,
+                          const Export *import) {
+    BeamJitcModule *m = static_cast<BeamJitcModule *>(inst);
+    const JitcPatchList *l = find_list(m->import_patches, index);
+    if (l) {
+        apply_patches(*l, rw_base, (Eterm)import);
+    }
+}
+
+void beamjitc_patch_literal(void *inst, char *rw_base, int index, Eterm lit) {
+    BeamJitcModule *m = static_cast<BeamJitcModule *>(inst);
+    const JitcPatchList *l = index >= 0
+                                    ? find_list(m->literal_patches, index)
+                                    : find_list(m->dyn_literal_patches, ~index);
+    if (l) {
+        apply_patches(*l, rw_base, lit);
+    }
+}
+
+void beamjitc_patch_lambda(void *inst,
+                          char *rw_base,
+                          int index,
+                          const ErlFunEntry *fe) {
+    BeamJitcModule *m = static_cast<BeamJitcModule *>(inst);
+    const JitcPatchList *l = find_list(m->lambda_patches, index);
+    if (l) {
+        apply_patches(*l, rw_base, (Eterm)fe);
+    }
+}
+
+void beamjitc_patch_strings(void *inst, char *rw_base, const byte *strtab) {
+    BeamJitcModule *m = static_cast<BeamJitcModule *>(inst);
+    apply_patches(m->string_patches, rw_base, (Eterm)strtab);
+}
+
+void *beamjitc_register_metadata(void *inst, const BeamCodeHeader *header) {
+    BeamJitcModule *m = static_cast<BeamJitcModule *>(inst);
+    std::vector<AsmRange> ranges;
+    std::string module_name = getAtomName(m->mod);
+
+    (void)header;
+    ranges.push_back({.start = (ErtsCodePtr)m->exec_base,
+                      .stop = (ErtsCodePtr)(m->exec_base + m->code_size),
+                      .name = module_name});
+
+    return beamasm_metadata_insert(module_name,
+                                   (ErtsCodePtr)m->exec_base,
+                                   m->code_size,
+                                   ranges);
+}
+
+#endif /* ERTS_JITC */
