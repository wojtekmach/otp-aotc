+#ifdef __linux__
+static int build_id_callback(struct dl_phdr_info *info, size_t size, void *out)
+{
+    int i;
+    (void)size;
+    for (i = 0; i < info->dlpi_phnum; i++) {
+        const ElfW(Phdr) *ph = &info->dlpi_phdr[i];
+        const byte *p, *end;
+        if (ph->p_type != PT_NOTE)
+            continue;
+        p = (const byte *)(info->dlpi_addr + ph->p_vaddr);
+        end = p + ph->p_memsz;
+        while (p + sizeof(ElfW(Nhdr)) <= end) {
+            const ElfW(Nhdr) *nh = (const ElfW(Nhdr) *)p;
+            const byte *name = p + sizeof(ElfW(Nhdr));
+            const byte *desc = name + ((nh->n_namesz + 3) & ~3u);
+            if (nh->n_type == NT_GNU_BUILD_ID && nh->n_namesz == 4 &&
+                memcmp(name, "GNU", 4) == 0 && nh->n_descsz >= 8) {
+                memset(out, 0, 16);
+                memcpy(out, desc, nh->n_descsz < 16 ? nh->n_descsz : 16);
+                return 1;
+            }
+            p = desc + ((nh->n_descsz + 3) & ~3u);
+        }
+    }
+    return 1;
+}
+#endif
+
+void erts_aot_emulator_uuid(unsigned char out[16])
+{
+    static int have = 0;
+    static unsigned char uuid[16];
+
+    if (!have) {
+        int found = 0;
+#if defined(__APPLE__)
+        const struct mach_header_64 *mh =
+            (const struct mach_header_64 *)_dyld_get_image_header(0);
+        const struct load_command *lc = (const struct load_command *)(mh + 1);
+        uint32_t i;
+        for (i = 0; i < mh->ncmds; i++) {
+            if (lc->cmd == LC_UUID) {
+                memcpy(uuid, ((const struct uuid_command *)lc)->uuid, 16);
+                found = 1;
+                break;
+            }
+            lc = (const struct load_command *)((const char *)lc + lc->cmdsize);
+        }
+#elif defined(__linux__)
+        memset(uuid, 0, sizeof(uuid));
+        dl_iterate_phdr(build_id_callback, uuid);
+        {
+            int i;
+            for (i = 0; i < 16; i++)
+                found |= uuid[i] != 0;
+        }
+#endif
+        if (!found) {
+            const char *s = ERLANG_VERSION " " __DATE__ " " __TIME__;
+            Uint64 h = 1469598103934665603ULL;
+            int i;
+            for (i = 0; s[i]; i++) {
+                h = (h ^ (unsigned char)s[i]) * 1099511628211ULL;
+            }
+            memset(uuid, 0, sizeof(uuid));
+            memcpy(uuid, &h, 8);
+        }
+        have = 1;
+    }
+    memcpy(out, uuid, 16);
+}
