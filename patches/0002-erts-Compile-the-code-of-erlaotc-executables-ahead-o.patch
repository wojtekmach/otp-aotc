+int erts_aot_preloaded(const char *name, const byte **code, Uint *size)
+{
+    char path[256];
+    ZipEntry *e = NULL;
+    int n;
+
+    if (!erts_aot_active)
+        return 0;
+
+    n = snprintf(path, sizeof(path), JITC_DIR "preloaded/%s.beam", name);
+    if (n > 0 && n < (int)sizeof(path))
+        e = find_entry(path);
+    if (e == NULL)
+        fatal("the recorded preloaded module is missing", name);
+    *code = entry_data(e);
+    *size = e->size;
+    return 1;
+}
